# ==========================================
# Car Minder Configuration Template
# Copy this file to .env and fill in your values
# ==========================================

# General Application Settings
# APP__MODE: "dev" or "prod"
APP__MODE="prod"
APP__DOMAIN="carminder.example.com"

# Uvicorn / Server Network Settings
APP__RUN__HOST=0.0.0.0
APP__RUN__PORT=8000

# API Settings
APP__API__PREFIX="/api"

# CORS Settings (JSON list of allowed origins)
APP__CORS__ORIGINS='["http://localhost:8000","http://127.0.0.1:8000"]'

# Database Settings
APP__DB__FILE_PATH=/app/backend/data/db.sqlite

# Security & Auth Settings
# Generate secret key: python -c "import secrets; print(secrets.token_hex(32))"
APP__AUTH__SECRET_KEY=change_this_to_a_random_secure_secret_key_32_bytes_min
APP__AUTH__ALGORITHM=HS256
APP__AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Telegram Bot Integration (Optional - leave empty to disable)
# Token from @BotFather
APP__BOT__TOKEN=
# Generate via python -c "import secrets; print(secrets.token_hex(32))"
APP__BOT__WEBHOOK_SECRET=